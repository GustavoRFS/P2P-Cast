{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "P2P-Cast Tauri",
  "version": "0.2.0",
  "identifier": "com.p2pcast.desktop.tauri",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev -- --host 127.0.0.1 --strictPort",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "P2P-Cast",
        "width": 1280,
        "height": 820,
        "minWidth": 780,
        "minHeight": 620,
        "backgroundColor": "#07111f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https: wss: http://localhost:3001 http://127.0.0.1:3001 ws://localhost:3001 ws://127.0.0.1:3001 https://0.peerjs.com wss://0.peerjs.com:443; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "category": "SocialNetworking",
    "shortDescription": "Transmissão P2P entre amigos",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["p2pcast"]
      }
    }
  }
}
