{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "P2P-Cast Tauri",
  "version": "0.2.0",
  "identifier": "com.p2pcast.desktop.tauri",
  "build": {
    "beforeDevCommand": "npm --prefix ../app-react-native run start -- --port 5173",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix ../app-react-native run export:web",
    "frontendDist": "../../app-react-native/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "P2P-Cast",
        "width": 1280,
        "height": 820,
        "minWidth": 780,
        "minHeight": 620,
        "backgroundColor": "#07111f",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https: wss: http://localhost:3001 http://127.0.0.1:3001 ws://localhost:3001 ws://127.0.0.1:3001 https://peerjs.ligmacharl.es wss://peerjs.ligmacharl.es:443; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../../desktop/resources/p2pcast-process-audio.exe": "p2pcast-process-audio.exe",
      "../../desktop/resources/p2pcast-wgc-capture.exe": "p2pcast-wgc-capture.exe"
    },
    "category": "SocialNetworking",
    "shortDescription": "Transmissão P2P entre amigos",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "p2pcast-tauri"
        ]
      }
    }
  }
}
