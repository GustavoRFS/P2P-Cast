{
  "name": "p2p-cast-desktop",
  "version": "0.2.0",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build:renderer": "npm --prefix ../web run build",
    "build": "npm run build:renderer && electron-builder --dir",
    "build:audio:windows": "cmake -S native/windows -B native/windows/build -DCMAKE_BUILD_TYPE=Release && cmake --build native/windows/build --config Release && node scripts/copy-windows-helper.cjs",
    "build:win": "npm run build:renderer && npm run build:audio:windows && electron-builder --win nsis",
    "build:mac": "npm run build:renderer && electron-builder --mac dmg",
    "build:linux": "npm run build:renderer && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.p2pcast.desktop",
    "productName": "P2P-Cast",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "../web/dist", "to": "web-dist" },
      { "from": "resources", "to": "resources" }
    ],
    "protocols": [
      { "name": "P2P-Cast login callback", "schemes": ["p2pcast"] }
    ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.social-networking" },
    "linux": { "target": "AppImage", "category": "Network" }
  }
}
